# Copy this file to `.env` and fill in your real values.
# NEVER commit your actual `.env` file — it is gitignored.
# Use a password manager or secrets vault for real credentials.

# MongoDB connection string (for MongoDB Atlas, credentials are embedded in the URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/caffeine

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Optional: admin user seeded on first server start (server/seed.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# CORS allowed origin for the frontend (Vite dev server default)
CLIENT_ORIGIN=http://localhost:5173

# Optional: server port (defaults to 5000)
# PORT=5000
